---
import "../styles/global.css";

const channelUrl = "https://www.youtube.com/@CodeWithAndrewFord";

const videos = [
  {
    title: "SlideVids: A quick walkthrough of making a video fast",
    description: "See how an outline becomes a complete AI-narrated video without a traditional editing workflow.",
    id: "qDBjAvzqHkk",
  },
  {
    title: "The Git feature I wish I’d known about years ago",
    description: "Learn how Git worktrees make it easier to work across branches without constantly switching context.",
    id: "tuRRuVcZTew",
  },
  {
    title: "Automate GitHub security updates with AI agents",
    description: "A practical look at using AI tools to turn repetitive project maintenance into a faster workflow.",
    id: "qGGd2_qayH4",
  },
];

const topics = [
  {
    number: "01",
    title: "Build with AI",
    text: "Practical ways to use modern AI tools while staying in control of the code and the outcome.",
  },
  {
    number: "02",
    title: "Ship useful software",
    text: "Real projects, honest trade-offs, and the small decisions that turn an idea into something people can use.",
  },
  {
    number: "03",
    title: "Work smarter",
    text: "Developer workflows for Git, automation, and the tools that remove friction from everyday work.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Code with Andrew Ford explores practical software development, AI tools, automation, and the process of shipping useful products."
    />
    <meta name="theme-color" content="#f7f6f1" />
    <meta property="og:title" content="Code with Andrew Ford" />
    <meta
      property="og:description"
      content="Practical ideas for building better software with modern tools."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://codewithandrewford.co.nz/" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://codewithandrewford.co.nz/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Code with Andrew Ford</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header wrapper">
      <a class="brand" href="/" aria-label="Code with Andrew Ford home">
        <span class="brand-mark" aria-hidden="true">&lt;/&gt;</span>
        <span>Code with Andrew Ford</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#videos">Watch</a>
        <a href="#topics">Topics</a>
        <a class="nav-channel" href={channelUrl}>YouTube ↗</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero wrapper" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Software development, without the theatre</p>
          <h1 id="hero-title">Make things.<br /><em>Learn out loud.</em></h1>
          <p class="hero-intro">
            I’m Andrew Ford, a software engineer and educator from New Zealand. On this channel I share practical ways to build, automate, and ship better software with modern tools.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={channelUrl}>
              Watch on YouTube
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </a>
            <a class="text-link" href="#videos">Explore the latest videos <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <div class="code-card" aria-label="A stylised code editor showing Andrew’s approach">
          <div class="code-card-bar">
            <span></span><span></span><span></span>
            <p>approach.ts</p>
          </div>
          <pre><code><span class="line-number">01</span> <span class="keyword">const</span> idea = <span class="string">"make it useful"</span>;
<span class="line-number">02</span>
<span class="line-number">03</span> <span class="keyword">while</span> (learning) &#123;
<span class="line-number">04</span>   build();
<span class="line-number">05</span>   share(<span class="string">"what worked"</span>);
<span class="line-number">06</span>   improve();
<span class="line-number">07</span> &#125;
<span class="line-number">08</span>
<span class="line-number">09</span> <span class="comment">// No hype required.</span></code></pre>
          <div class="code-card-status">
            <span><i></i> Building in public</span>
            <span>NZST</span>
          </div>
        </div>
      </section>

      <section class="videos wrapper" id="videos" aria-labelledby="videos-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Start here</p>
            <h2 id="videos-title">Latest videos</h2>
          </div>
          <a class="text-link desktop-link" href={`${channelUrl}/videos`}>View all videos <span aria-hidden="true">↗</span></a>
        </div>

        <div class="video-grid">
          {videos.map((video, index) => (
            <article class="video-card">
              <a class="video-image" href={`https://www.youtube.com/watch?v=${video.id}`} aria-label={`Watch ${video.title} on YouTube`}>
                <img
                  src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
                  alt=""
                  width="480"
                  height="360"
                  loading={index === 0 ? "eager" : "lazy"}
                />
                <span class="play" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
                </span>
              </a>
              <div class="video-body">
                <p class="video-number">0{index + 1}</p>
                <div>
                  <h3><a href={`https://www.youtube.com/watch?v=${video.id}`}>{video.title}</a></h3>
                  <p>{video.description}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
        <a class="text-link mobile-link" href={`${channelUrl}/videos`}>View all videos <span aria-hidden="true">↗</span></a>
      </section>

      <section class="topics" id="topics" aria-labelledby="topics-title">
        <div class="wrapper">
          <div class="section-heading topics-heading">
            <div>
              <p class="eyebrow">What you’ll find</p>
              <h2 id="topics-title">Useful ideas,<br />clearly explained.</h2>
            </div>
            <p class="topics-intro">Short lessons and longer walkthroughs for curious people who like making things with code.</p>
          </div>

          <div class="topic-list">
            {topics.map((topic) => (
              <article class="topic">
                <p>{topic.number}</p>
                <h3>{topic.title}</h3>
                <p>{topic.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="cta wrapper" aria-labelledby="cta-title">
        <p class="eyebrow">New videos and experiments</p>
        <h2 id="cta-title">Come build with me.</h2>
        <p>Subscribe for practical software development, AI-assisted workflows, and lessons from shipping real products.</p>
        <a class="button button-primary" href={channelUrl}>
          Visit the channel
          <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <footer class="site-footer wrapper">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">&lt;/&gt;</span>
        <span>Code with Andrew Ford</span>
      </a>
      <p>Made in Tauranga, New Zealand.</p>
      <div>
        <a href="https://andrewford.co.nz">Andrew’s website ↗</a>
        <a href={channelUrl}>YouTube ↗</a>
      </div>
    </footer>
  </body>
</html>
